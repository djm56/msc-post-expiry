msgstr "Süresi Dolmuş Yazılar için SEO Ayarları"

#: includes/class-mscpe-settings.php:777
msgid "Configure how search engines handle expired content."
msgstr ""
"Arama motorlarının süresi dolmuş içeriği nasıl işlediğini yapılandırın."

#: includes/class-mscpe-settings.php:785
msgid "Noindex"
msgstr "Noindex"

#: includes/class-mscpe-settings.php:789
msgid "Add noindex to expired posts (prevents indexing)."
msgstr "Süresi dolmuş yazılara noindex ekleyin (indekslemeyi önler)."

#: includes/class-mscpe-settings.php:794
msgid "Nofollow"
msgstr "Nofollow"

#: includes/class-mscpe-settings.php:798
msgid "Add nofollow to expired posts (prevents link following)."
msgstr "Süresi dolmuş yazılara nofollow ekleyin (bağlantı takibini önler)."

