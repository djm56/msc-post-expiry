msgstr "Dodaj noindex do wygasłych wpisów (zapobiega indeksowaniu)."

#: includes/class-mscpe-settings.php:794
msgid "Nofollow"
msgstr "Nofollow"

#: includes/class-mscpe-settings.php:798
msgid "Add nofollow to expired posts (prevents link following)."
msgstr "Dodaj nofollow do wygasłych wpisów (zapobiega podążaniu za linkami)."

