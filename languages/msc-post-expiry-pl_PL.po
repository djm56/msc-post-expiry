#: includes/class-mscpe-settings.php:335
msgid "What should happen when a post expires."
msgstr "Co powinno się stać, gdy wpis wygaśnie."

#: includes/class-mscpe-settings.php:339
msgid "Expiry category"
msgstr "Kategoria wygaśnięcia"

#: includes/class-mscpe-settings.php:342
