msgstr "Історія дій завершення"

#: includes/class-mscpe-settings.php:1209
msgid "Recent expiry actions (last 50 entries)."
msgstr "Нещодавні дії завершення (останні 50 записів)."

#: includes/class-mscpe-settings.php:1212
msgid "No expiry actions recorded yet."
msgstr "Дії завершення ще не записано."

