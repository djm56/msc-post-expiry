<?xml version="1.0"?>
<ruleset name="MSC Security">
  <description>Security-focused PHPCS ruleset for MSC plugins. Deliberately NOT WordPress-Extra:
    only sniffs with direct security impact, so the signal stays triageable.</description>

  <!-- Output escaping, input handling, CSRF (WPCS) -->
  <rule ref="WordPress.Security.EscapeOutput"/>
  <rule ref="WordPress.Security.NonceVerification"/>
  <rule ref="WordPress.Security.ValidatedSanitizedInput"/>
  <rule ref="WordPress.Security.PluginMenuSlug"/>
  <rule ref="WordPress.Security.SafeRedirect"/>

  <!-- SQL safety (WPCS) -->
  <rule ref="WordPress.DB.PreparedSQL"/>
  <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
  <rule ref="WordPress.DB.RestrictedFunctions"/>
  <rule ref="WordPress.DB.RestrictedClasses"/>
  <rule ref="WordPress.DB.DirectDatabaseQuery"/>

  <!-- Dangerous PHP constructs -->
  <rule ref="Squiz.PHP.Eval"/>
  <rule ref="Generic.PHP.BacktickOperator"/>
  <rule ref="Generic.PHP.Syntax"/>
  <rule ref="WordPress.PHP.DontExtract"/>
  <rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
  <rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
  <rule ref="WordPress.PHP.DevelopmentFunctions"/>
  <rule ref="WordPress.PHP.IniSet"/>
  <rule ref="WordPress.PHP.NoSilencedErrors"/>
  <rule ref="WordPress.PHP.StrictInArray"/>

  <!-- WordPress API misuse with security impact -->
  <rule ref="WordPress.WP.AlternativeFunctions"/>
  <rule ref="WordPress.WP.DeprecatedFunctions"/>
  <rule ref="WordPress.WP.DeprecatedClasses"/>
  <rule ref="WordPress.WP.DeprecatedParameters"/>
  <rule ref="WordPress.WP.DeprecatedParameterValues"/>
  <rule ref="WordPress.WP.EnqueuedResources"/>
  <rule ref="WordPress.WP.GlobalVariablesOverride"/>

  <!-- Command execution: forbid outright -->
  <rule ref="Generic.PHP.ForbiddenFunctions">
    <properties>
      <property name="forbiddenFunctions" type="array">
        <element key="exec" value="NULL"/>
        <element key="shell_exec" value="NULL"/>
        <element key="system" value="NULL"/>
        <element key="passthru" value="NULL"/>
        <element key="proc_open" value="NULL"/>
        <element key="popen" value="NULL"/>
        <element key="pcntl_exec" value="NULL"/>
        <element key="dl" value="NULL"/>
      </property>
    </properties>
  </rule>

  <config name="minimum_supported_wp_version" value="5.9"/>

  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/tests/*</exclude-pattern>
  <exclude-pattern>*/dist/*</exclude-pattern>
  <exclude-pattern>*/scan-reports/*</exclude-pattern>

  <arg name="extensions" value="php"/>
</ruleset>
